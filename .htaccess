#Options +FollowSymlinks
RewriteEngine on

# Pas de redirection HTTPS pour localhost / IP locale
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1|::1)(:\d+)?$ [NC]
RewriteRule ^ - [L]
RewriteCond %{HTTPS} !=on
RewriteRule (.*) https://%{SERVER_NAME}/$1 [R=301] 

<IfModule mod_headers.c>
    Header set Content-Security-Policy "upgrade-insecure-requests;"
</IfModule>

# CORS fonts
<IfModule mod_headers.c>
    <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# L'ancienne page catalogue n'est plus indexee (remplacee par products.php)
<IfModule mod_headers.c>
    <Files "dbproducts.php">
        Header set X-Robots-Tag "noindex, nofollow"
    </Files>
</IfModule>

# Bloquer l'accès direct aux includes
RewriteRule ^includes/ - [F,L]

# Routes du site : familles et produits en adresses lisibles
#   products/Figs/            famille (products/Figs/2/ = page 2)
#   products_detail/Figs/     produit
#   guides/figs/              guide acheteur
# L'ORDRE COMPTE : les routes precises passent avant la regle generale des familles.

# 1) Recherche et tags
RewriteRule ^products/search/([A-Za-z0-9-]+)/?$  products/products.php?motCle=$1 [NC,L]
RewriteRule ^products/tags/([A-Za-z0-9-]+)/?$  products/products.php?tags=$1 [NC,L]

# 2) Anciennes adresses avec numero (products/16/Figs/) : redirigees definitivement (301)
#    vers l'adresse par nom, pour conserver le referencement.
RewriteRule ^products/[0-9]+/([A-Za-z0-9-]+)/([0-9]+)/?$  products/$1/$2/ [R=301,L]
RewriteRule ^products/[0-9]+/([A-Za-z0-9-]+)/?$  products/$1/ [R=301,L]

# 3) Guides acheteurs
RewriteRule ^guides/([A-Za-z0-9-]+)/?$  products/produit.php?slug=$1 [NC,L,QSA]

# 4) Familles de produits (products.php verifie que la famille existe)
RewriteRule ^products/([A-Za-z0-9-]+)/([0-9]+)/?$  products/products.php?catslug=$1&page=$2 [NC,L,QSA]
RewriteRule ^products/([A-Za-z0-9-]+)/?$  products/products.php?catslug=$1 [NC,L,QSA]
RewriteRule ^products/?$  products/products.php [NC,L,QSA]

RewriteRule ^home/?$ index.php [L]
RewriteRule ^about-us/?$ about-us.php [L]
RewriteRule   about-us$  about-us.php [L]
# Plan du site pour Google
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Pages de presentation
RewriteRule ^how-we-work/?$   how-we-work.php [L]
RewriteRule ^quality/?$       quality.php [L]
RewriteRule ^morocco/?$       morocco.php [L]
RewriteRule ^why-foodmax/?$   why-foodmax.php [L]
RewriteRule ^fresh-produce-exporter-morocco/?$   fresh-produce-exporter-morocco.php [L]
RewriteRule ^export-services/?$   export-services.php [L]
RewriteRule ^for-importers/?$   for-importers.php [L]
RewriteRule ^api/chatbot/?$   api/chatbot.php [L]
RewriteRule   ^privacy-policy/?$  privacy-policy.php [L]
RewriteRule   ^terms/?$  terms.php [L]
RewriteRule   shop-cart/$   Shop-cart.php [L]
RewriteRule   gallery/$  gallery.php [L]
RewriteRule   gallery$  gallery.php [L]
RewriteRule   ^contact/$  contact.php [L]
RewriteRule   ^contact$  contact.php [L]
RewriteRule   ^blog$  blog.php [L,QSA]
RewriteRule   ^blog/$  blog.php [L,QSA]
RewriteRule   ^blog/([A-Za-z0-9-]+)/?$  blog-post.php?slug=$1 [L,QSA]
# Ancien catalogue (dbproducts) : redirige definitivement vers le nouveau
RewriteRule   ^dbproducts/?$  products/ [R=301,L]
RewriteRule   products/$  products/products.php [L]
RewriteRule   products$  products/products.php [L]
RewriteRule   offers/$  offers.php [L]
RewriteRule  offers-online/$ offers-online.php [L]
RewriteRule  offers/Tomatoes/$  products/Tomatoes-detail.php [L]
RewriteRule  offers/Citrus/$  products/Citrus-detail.php [L]
RewriteRule  offers/Cereals/$  products/Cereals-detail.php [L]
RewriteRule  offers/Watermelon/$  products/Watermelon-detail.php [L]
RewriteRule  offers/Fish/$  products/Fish-detail.php [L]
RewriteRule  offers/Olives/$  products/Olives-detail.php [L]
RewriteRule  offers/Peppers/$  products/Peppers-detail.php [L]
RewriteRule  offers/Valencia/$  products/Valencia-detail.php [L]
RewriteRule  offers/Canned_fish/$  products/canned_fish.php [L]
RewriteRule  offers/Cashew/$  products/Cashew-detail.php [L]
RewriteRule   ^dbproducts/tags/([A-Za-z0-9-]+)/([0-9]+)/?$  products/tags/$1/ [R=301,L]
RewriteRule   ^dbproducts/([0-9]+)/([A-Za-z0-9-]+)/?$  products/$2/ [R=301,L]
RewriteRule   ^dbproducts/([0-9]+)/([A-Za-z0-9-]+)/([0-9]+)/?$  products/$2/$3/ [R=301,L]
RewriteRule   ^dbproducts/([0-9]+)/?$  products/?page=$1 [R=301,L]
RewriteRule   ^products_detail/([0-9]+)/?$  products/products_detail.php?prod_id=$1 [NC,L]
RewriteRule   ^products_detail/([A-Za-z0-9-]+)/?$  products/products_detail.php?prod_slug=$1 [NC,L]
RewriteRule   ^dbproducts/search/([A-Za-z0-9-]+)/([0-9]+)/?$  products/search/$1/ [R=301,L]
RewriteRule   ^dbGallery/([0-9]+)/?$  dbGallery.php?page=$1 [NC,L]
RewriteRule   ^gallery/([0-9]+)/?$  gallery.php?page=$1
RewriteRule   ^offers/([0-9]+)/?$  offers.php?page=$1 [NC,L]
RewriteRule   ^offers-online/([0-9]+)/?$  offers-online.php?page=$1 [NC,L]
RewriteRule   ^offers-online/([A-Za-z0-9-]+)/([0-9]+)/?$  offers-online.php?update=$1&page=$2 [NC,L]
RewriteRule   ^offers-online/([A-Za-z0-9-]+)/?$  offers-online.php?update [NC,L]
RewriteRule   ^detail-view/([0-9]+)/([A-Za-z0-9-]+)/?$  products/detail-view.php?w=$1&name=$2 [NC,L]

